<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTituloDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrar Entrega"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etCantidadEntrega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cantidad a entregar"
        android:inputType="number"
        android:importantForAutofill="no"
        tools:ignore="SpeakableTextPresentCheck" />

    <EditText
        android:id="@+id/etPersonaRecibe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre de quien recibe"
        android:inputType="textPersonName"
        android:importantForAutofill="no"
        tools:ignore="SpeakableTextPresentCheck" />

    <EditText
        android:id="@+id/etAreaDestino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Área de destino"
        android:inputType="text"
        android:importantForAutofill="no"
        tools:ignore="SpeakableTextPresentCheck" />

</LinearLayout>